      <!-- 個別商品ページ -->
      <section id="panel-productlp" class="tab-panel" hidden>
        <header>
          <h1>個別商品ページ</h1>
          <p>
            売れる1商品に特化した記事型ページを作成します。構成・デザインはコジマ特集記事と同じ（H1→導入→H2/H3→スペック表→FAQ→まとめ＋CTA）。
          </p>
          <p class="field-hint draft-restore-hint" id="productlp-draft-hint" hidden></p>
          <div class="actions draft-discard-actions">
            <button type="button" class="secondary" id="productlp-draft-discard">下書きを破棄</button>
          </div>
          <div class="aeo-intent-panel" aria-label="個別商品ページの AEO GEO SEO 意図">
            <p class="aeo-intent-lead">個別商品ページの意図</p>
            <ul class="aeo-intent-list">
              <li>
                <span class="pillar-tag pillar-aeo">AEO</span>
                冒頭の直接回答と各段落冒頭の答えの1文で、質問への答えを抜き出しやすく
              </li>
              <li>
                <span class="pillar-tag pillar-geo">GEO</span>
                向き不向き・スペック表・FAQで引用しやすい事実を整理
              </li>
              <li>
                <span class="pillar-tag pillar-seo">SEO</span>
                商品名・型番入り title / meta と購入CTAで検索〜CVをつなぐ
              </li>
            </ul>
          </div>
        </header>

        <section class="panel">
          <h2>1. 商品情報・トーン</h2>
          <form id="form-productlp" class="form">
            <label class="field">
              <span>カテゴリ</span>
              <select id="productlp-category"></select>
              <input type="text" id="productlp-category-other" class="category-other-input" placeholder="カテゴリ名" hidden />
            </label>
            <label class="field">
              <span>訴求トーン *</span>
              <select id="productlp-tone" name="tone">
                <option value="standard">通常（個別商品ページ）</option>
                <option value="new_release" selected>新製品発売</option>
              </select>
            </label>
            <label class="field">
              <span>メーカー</span>
              <input type="text" id="productlp-manufacturer" placeholder="例: ビックアイデア" />
            </label>
            <label class="field">
              <span>商品名 *</span>
              <input type="text" id="productlp-name" required placeholder="例: スポットクーラー" />
            </label>
            <label class="field">
              <span>型番</span>
              <input type="text" id="productlp-model" placeholder="例: BIM-PA26A" />
            </label>
            <label class="field">
              <span>発売日</span>
              <input type="text" id="productlp-release-date" placeholder="例: 2026年8月 / 2026-08-01" />
              <span class="field-hint">分かる範囲で可（年月のみでも可）</span>
            </label>
            <label class="field checkbox-field">
              <input type="checkbox" id="productlp-reservation" />
              <span>予約受付中</span>
            </label>
            <label class="field">
              <span>メーカー公式URL</span>
              <input type="url" id="productlp-official-url" placeholder="https://" />
              <span class="field-hint">入力するとページ内容を取得して原稿の参考にします</span>
            </label>
            <label class="field">
              <span>参考URL（レビュー・特集など）</span>
              <input type="url" id="productlp-reference-url" placeholder="https://" />
              <span class="field-hint">入力すると取得して構成・説明の参考にします</span>
            </label>
            <label class="field">
              <span>購入先URL（CTA）</span>
              <input type="url" id="productlp-purchase-url" placeholder="コジマ／Amazon 等の商品詳細" />
            </label>
            <label class="field">
              <span>CTAラベル</span>
              <input type="text" id="productlp-cta-label" placeholder="新製品の詳細・ご購入はこちら" />
            </label>
            <label class="field">
              <span>補足特長・メモ</span>
              <textarea id="productlp-notes" rows="4" placeholder="例: 冷風・温風・ドライ・送風の1台4役。おやすみ運転。キャスター付き。"></textarea>
            </label>

            <fieldset class="productlp-options-fieldset productlp-images-fieldset">
              <legend>画像</legend>
              <p class="field-hint">
                メイン画像はファーストビュー（タイトル直下）に入ります。URLが空のときはサンプル画像を使います。その他画像は挿入位置を指定できます。
              </p>
              <label class="field">
                <span>メイン画像URL（ファーストビュー）</span>
                <input type="url" id="productlp-main-image-url" placeholder="https://（空ならサンプル画像）" />
              </label>
              <label class="field">
                <span>メイン画像の代替テキスト</span>
                <input type="text" id="productlp-main-image-alt" placeholder="例: ビックアイデア スポットクーラー BIM-PA26A" />
              </label>
              <div id="productlp-images-list" class="productlp-options-list"></div>
              <div class="actions">
                <button type="button" class="secondary" id="productlp-add-image">その他画像を追加</button>
              </div>
            </fieldset>

            <fieldset class="productlp-options-fieldset">
              <legend>オプション品（任意・プラスワン）</legend>
              <p class="field-hint">
                別売の窓パネル・ダクト延長・フィルターなどがある場合に追加します。名称があれば原稿に「あわせて使いたいオプション」として含めます。
              </p>
              <div id="productlp-options-list" class="productlp-options-list"></div>
              <div class="actions">
                <button type="button" class="secondary" id="productlp-add-option">オプション品を追加</button>
              </div>
            </fieldset>

            <label class="field checkbox-field">
              <input type="checkbox" id="productlp-skip-scrape" />
              <span>URLを取得せず、入力メモだけで生成する</span>
            </label>
            <div class="actions">
              <button type="submit" id="productlp-submit">個別商品ページを生成</button>
              <button type="button" class="secondary" id="productlp-fill-sample">BIM-PA26Aサンプルを入れる</button>
              <button type="button" class="secondary" id="productlp-reset">リセット</button>
            </div>
          </form>
          <p id="productlp-error" class="error" hidden></p>
          <p class="field-hint" id="productlp-status"></p>
        </section>

